# Secrets
.env
# Tauri updater signing keypair -- never generate/keep this inside the repo
# (see apps/desktop-shell/README.md), but ignore it here defensively anyway.
apps/desktop-shell/**/*.key
apps/desktop-shell/**/*.key.pub

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.venv311/
.venv_api/
node_modules/
.next/
.turbo/
# apps/web's static export -- apps/desktop-shell's Tauri config points
# frontendDist straight at this (`npm run build:desktop --workspace=@prism/web`
# rebuilds it); never committed.
apps/web/out/
# apps/api's PyInstaller sidecar binary (apps/api/build_sidecar.py rebuilds
# it, ~150-500MB) -- never committed.
apps/desktop-shell/src-tauri/binaries/
apps/api/build/
apps/api/dist/
apps/api/*.spec
.prism/work/
.prism/runtime/
**/.prism/work/
**/.prism/runtime/
test-results/
playwright-report/
venv/

# Streamlit
.streamlit/secrets.toml

# Corpus benchmark — downloaded real-world data is never committed;
# corpus_registry.json (URLs only) is the thing that's tracked.
corpus_cache/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tsbuildinfo
