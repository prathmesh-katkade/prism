{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:tray:default",
    "core:menu:default",
    "global-shortcut:default",
    "notification:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "prism-api", "sidecar": true }]
    }
  ]
}
