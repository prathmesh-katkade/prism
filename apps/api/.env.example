# Copy to apps/api/.env for local development. Never commit a real .env file — it's gitignored.
# In staging/production, set these as the hosting platform's environment variables instead of a
# checked-in file. Nothing here is required: FastAPI boots and every native workflow (Overview,
# SQL Lab, AI Analyst, Clean, Visualize) works with zero configuration, using the deterministic
# path and no external database.

# CORS — comma-free JSON array of exact origins the browser app is served from. Never use "*"
# for credentialed traffic. Defaults to the two local Next.js dev origins if unset.
# development:
# PRISM_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
# staging (example — replace with your actual deployed frontend origin):
# PRISM_ALLOWED_ORIGINS=["https://prism-native-web-staging.onrender.com"]
# production (example):
# PRISM_ALLOWED_ORIGINS=["https://prism.example.com"]

# Optional local/free AI provider routing. Leave unset (or "deterministic") to run PRISM without
# any AI provider at all — AI Analyst still answers from compact server-held evidence.
# PRISM_AI_PROVIDER=deterministic

# Only read when PRISM_AI_PROVIDER=ollama. PRISM_OLLAMA_BASE_URL must point at a server-reachable
# Ollama instance — 127.0.0.1 here means the API container's own loopback, not your workstation.
# Never expose an Ollama instance publicly to make it reachable from a hosted deployment; use a
# private network/tunnel you control instead, or leave AI Analyst on its deterministic path.
# PRISM_OLLAMA_BASE_URL=http://127.0.0.1:11434
# PRISM_OLLAMA_MODEL=llama3.2:3b
# Optional promoted deep-tier runtime; a verified deep pointer is required before use.
# PRISM_ATLAS_DEEP_OLLAMA_MODEL=ministral-3:8b
# PRISM_OLLAMA_TIMEOUT_SECONDS=45

# Optional external SQL Lab connectors (Phase 4). Leave unset for local/DuckDB-only sources.
# PRISM_EXTERNAL_SQL_SOURCES_JSON=[{"id":"warehouse","label":"Warehouse","source_type":"postgresql","url_env":"PRISM_WAREHOUSE_URL"}]
# PRISM_WAREHOUSE_URL=postgresql+psycopg2://user:password@host:5432/dbname
# PRISM_SQLITE_SOURCES_JSON=[]
# PRISM_SQL_METADATA_PATH=

# Durable Atlas history (promotion pointers, AtlasBench runs, runtime bindings,
# lineage) — see docs/operations/durable-analytical-history.md. Unset locally,
# this resolves to a SQLite file at .prism/runtime/analytical-history.sqlite
# RELATIVE TO THE PROCESS'S CURRENT WORKING DIRECTORY -- launching the same
# checkout from two different working directories (or two different worktrees)
# silently creates two different, disconnected stores. If you intend to run
# against real/shared Atlas history rather than a fresh local one, set this
# explicitly to an ABSOLUTE path so every launch resolves to the same file
# regardless of cwd:
# PRISM_ANALYTICAL_HISTORY_DATABASE_URL=sqlite:///C:/absolute/path/to/analytical-history.sqlite
# Production/staging must use a real managed MySQL-compatible URL instead, and
# should also set PRISM_REQUIRE_DURABLE_HISTORY=true so a missing URL is a
# startup failure rather than a silent fallback to an ephemeral local file:
# PRISM_ANALYTICAL_HISTORY_DATABASE_URL=mysql+pymysql://user:password@host:3306/prism_history
# PRISM_REQUIRE_DURABLE_HISTORY=true

# Atlas execution controls. Increment the version whenever the policy changes;
# every accepted run records it, and each step records the policy at dispatch.
# PRISM_ATLAS_EXECUTION_POLICY_VERSION=atlas-execution-v1
# PRISM_ATLAS_PROFILE_ONLY=false
# PRISM_ATLAS_DISABLED_TOOLS=sql_lab.local_aggregate

# Set by the hosting platform, not by you — the app binds to $PORT (see uvicorn startCommand).
# PORT=8000

# Deployment security boundary — see docs/operations/deployment-security-boundary.md.
# Local is the only supported mode and must bind Uvicorn to 127.0.0.1. Declaring staging or
# production makes the API refuse to start until real OIDC/session/RBAC exists; a shared browser
# token is deliberately not accepted as a substitute for identity or authorization.
# PRISM_DEPLOYMENT_MODE=local
