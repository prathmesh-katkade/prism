# Copy to apps/web/.env.local for local development. Never commit a real .env.local file — it's
# gitignored. In staging/production, set this as the hosting platform's environment variable
# instead. See apps/web/src/config/api.ts for the single place this is read.

# The PRISM API's base origin. NEXT_PUBLIC_* is safe here: an API origin is not a secret, it's
# necessarily visible in every request the browser makes anyway. Never put a real secret (an API
# key, a credential, anything server-only) behind a NEXT_PUBLIC_* variable.
#
# development (default if unset):
# NEXT_PUBLIC_PRISM_API_URL=http://127.0.0.1:8000
#
# staging (example — replace with your actual deployed API origin):
# NEXT_PUBLIC_PRISM_API_URL=https://prism-native-api-staging.onrender.com
#
# production (example):
# NEXT_PUBLIC_PRISM_API_URL=https://api.prism.example.com
