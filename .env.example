# Copy this file to .env and fill in your real key — .env is gitignored so it
# never gets committed. Get a free Gemini API key at:
# https://aistudio.google.com/apikey

GEMINI_API_KEY=your_key_here

# Optional: persistent MySQL-backed storage for Saved Queries, Cleaning
# Recipes, and Session Snapshots ("Save to My Account" buttons). Leave
# unset and the app falls back to session-only (in-memory) storage for
# just these three features — nothing else is affected, no crash, no
# visible sign anything is missing.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=prism
